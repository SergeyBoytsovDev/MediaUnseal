<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.0</Version>
    <AssemblyName>MediaUnseal</AssemblyName>
    <RootNamespace>MediaUnseal</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\MediaUnseal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Remove="Assets\Icons\MediaUnseal.psd;Assets\avalonia-logo.ico" />
    <AvaloniaResource Include="docs\media-unseal-media-guide*.md" />
    <AvaloniaResource Include="docs\media-guide-diagrams.*.json" />
    <EmbeddedResource Include="docs\media-unseal-media-guide*.md" WithCulture="false" />
    <EmbeddedResource Include="docs\media-guide-diagrams.*.json" WithCulture="false" />
    <EmbeddedResource Update="Resources\Strings.ru.resx" WithCulture="false"
                      LogicalName="MediaUnseal.Resources.Strings.resources" />
    <Compile Remove="Tests/**/*.cs;Updater/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaUnseal.SmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.2" />
  </ItemGroup>
  <Target Name="PublishUpdateHelper" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'linux-x64'">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)Updater/MediaUnseal.Updater.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=true -o &quot;$(MSBuildThisFileDirectory)obj/updater-$(RuntimeIdentifier)/&quot;" />
    <PropertyGroup><UpdateHelperExtension Condition="'$(RuntimeIdentifier)' == 'win-x64'">.exe</UpdateHelperExtension></PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)obj/updater-$(RuntimeIdentifier)/MediaUnseal.Updater$(UpdateHelperExtension)"
          DestinationFolder="$(PublishDir)" />
  </Target></Project>




