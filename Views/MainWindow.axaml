<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TrackExtractor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TrackExtractor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TrackExtractor">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Настройки">
                <MenuItem Header="FFmpeg и FFprobe" Click="Dependencies_Click" />
            </MenuItem>
        </Menu>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="12">
                <TextBlock Text="{Binding Greeting}" TextWrapping="Wrap" />
                <TextBlock Text="Перетащите сюда один локальный медиафайл или выберите его кнопкой." TextWrapping="Wrap" />
                <Button Content="Выбрать файл" Click="SelectFile_Click" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding FileSelectionMessage}" TextWrapping="Wrap" />
                <Button Content="Открыть FFmpeg и FFprobe" Click="Dependencies_Click"
                        IsVisible="{Binding ShowDependencyOffer}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding AnalysisStatus}" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAnalyzing}" />
                <TextBlock Text="{Binding MediaSummary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ExportTracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExportTrackViewModel">
                            <StackPanel Margin="0,3" Spacing="2">
                                <CheckBox Content="{Binding Caption}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSelect}" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="24,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Выбрать папку" Click="ChooseFolder_Click" />
                    <Button Content="Извлечь" Click="Extract_Click" IsEnabled="{Binding CanExtract}" />
                    <Button Content="Остановить" Click="Stop_Click" IsVisible="{Binding IsExporting}" />
                </StackPanel>
                <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}"
                             IsIndeterminate="{Binding ExportProgressIndeterminate}" />
                <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap" />
                <Button Content="Сохранить лог" Click="SaveLog_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
