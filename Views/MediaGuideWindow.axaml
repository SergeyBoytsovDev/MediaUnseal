<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrackExtractor.Views.MediaGuideWindow"
        Title="Медиасправочник" Icon="/Assets/Icons/TrackExtractor-256.png"
        Width="980" Height="700" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Inter" FontSize="14">
 <Window.Styles>
  <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Style>
 </Window.Styles>
 <Grid ColumnDefinitions="215,*">
  <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <StackPanel Margin="12" Spacing="10">
    <TextBlock Text="Медиасправочник" FontSize="17" FontWeight="SemiBold" Margin="8,8,0,4"/>
    <ListBox x:Name="ArticlesList" SelectionChanged="Articles_SelectionChanged"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="30,25" Spacing="15">
    <TextBlock x:Name="ArticleTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <Border Height="1" Background="{DynamicResource LineBrush}"/>
    <TextBlock x:Name="ArticleBody" FontSize="15" LineHeight="24" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
