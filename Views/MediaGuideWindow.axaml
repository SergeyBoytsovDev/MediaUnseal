<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:Class="TrackExtractor.Views.MediaGuideWindow"
        Title="{DynamicResource Loc_GuideWindowTitle}" Icon="/Assets/Icons/TrackExtractor-256.png"
        Width="1100" Height="760" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Inter" FontSize="14">
 <Window.Styles>
  <Style Selector="TreeViewItem:selected">
   <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
  </Style>
  <Style Selector="Border.guide-diagram">
   <Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style Selector="Border.guide-frame, Border.guide-node">
   <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.guide-note">
   <Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBlock.guide-label">
   <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.guide-label.guide-hit">
   <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
  </Style>
  <Style Selector="Line.guide-arrow">
   <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
  </Style>
 </Window.Styles>
 <Grid RowDefinitions="Auto,*">
  <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource PanelAltBackground}"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
    <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="{DynamicResource Loc_GuideSearchPlaceholder}"
             TextChanged="Search_TextChanged"/>
    <Button x:Name="ClearSearchButton" Grid.Column="1" Content="{DynamicResource Loc_GuideClearSearch}"
            Click="ClearSearch_Click" IsEnabled="False"/>
    <TextBlock x:Name="SearchPosition" Grid.Column="2" VerticalAlignment="Center"
               Foreground="{DynamicResource MutedTextBrush}" MinWidth="75" TextAlignment="Center"/>
    <Button x:Name="PreviousMatchButton" Grid.Column="3" Content="{DynamicResource Loc_GuidePrevious}" Click="PreviousMatch_Click" IsEnabled="False"/>
    <Button x:Name="NextMatchButton" Grid.Column="4" Content="{DynamicResource Loc_GuideNext}" Click="NextMatch_Click" IsEnabled="False"/>
    <TextBlock x:Name="GuideFallbackNotice" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,6,0,0"
               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" IsVisible="False"/>
   </Grid>
  </Border>
 <Grid Grid.Row="1" ColumnDefinitions="1*,3*">
  <Border Grid.Column="0" Background="{DynamicResource PanelAltBackground}"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="18,17,12,15" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
     <TextBlock x:Name="NavigationTitle" Text="{DynamicResource Loc_GuideContents}" FontSize="17" FontWeight="SemiBold"/>
    </Border>
    <TreeView x:Name="ContentsTree" Grid.Row="1" Margin="6,8,6,10"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              SelectionChanged="Contents_SelectionChanged"/>
    <ListBox x:Name="ResultsList" Grid.Row="1" Margin="6,8,6,10" IsVisible="False"
             SelectionChanged="Results_SelectionChanged"/>
    <TextBlock x:Name="NoResultsText" Grid.Row="1" Margin="18,18,12,0" IsVisible="False"
               Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource Loc_GuideNoResults}"/>
   </Grid>
  </Border>
   <Border Grid.Column="1" Background="{DynamicResource PanelBackground}">
    <md:MarkdownScrollViewer x:Name="ArticleViewer" Margin="20,12,14,12" SelectionEnabled="True">
     <md:MarkdownScrollViewer.Styles>
      <Style Selector="ScrollViewer">
       <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
       <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
       <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
       <Setter Property="SelectionBrush" Value="{DynamicResource AccentHoverBrush}"/>
       <Setter Property="FontSize" Value="14"/>
       <Setter Property="Margin" Value="0,6"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading1">
       <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
       <Setter Property="FontSize" Value="25"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Margin" Value="0,16,0,12"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading2">
       <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
       <Setter Property="FontSize" Value="20"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Margin" Value="0,15,0,9"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading3">
       <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
       <Setter Property="FontSize" Value="18"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Margin" Value="0,12,0,8"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Table">
       <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
       <Setter Property="Margin" Value="0,10,0,16"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table > Border">
       <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
       <Setter Property="Padding" Value="8,6"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader">
       <Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.EvenTableRow">
       <Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
       <Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      </Style>
      <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
       <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
       <Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/>
      </Style>
     </md:MarkdownScrollViewer.Styles>
    </md:MarkdownScrollViewer>
   </Border>
 </Grid>
 </Grid>
</Window>
