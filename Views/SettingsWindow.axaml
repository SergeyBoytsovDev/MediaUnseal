<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaUnseal.ViewModels"
        x:Class="MediaUnseal.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="{DynamicResource Loc_SettingsTitle}" Icon="/Assets/Icons/MediaUnseal-256.png"
        Width="770" Height="570" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource MainTextBrush}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="14">
 <Window.Styles>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Style>
  <Style Selector="RadioButton"><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/></Style>
  <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Button.about-link">
   <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <ControlTemplate>
     <ContentPresenter Content="{TemplateBinding Content}"/>
    </ControlTemplate>
   </Setter>
  </Style>
  <Style Selector="Button.about-link TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>
  <Style Selector="Button.about-link:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/><Setter Property="TextDecorations" Value="Underline"/></Style>
  <Style Selector="Button.about-link:focus TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style>
  <Style Selector="Button.license-link">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
   <Setter Property="Template">
    <ControlTemplate>
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="1" CornerRadius="5">
      <Path Data="M11 3 L19 3 L19 11 M19 3 L9 13 M17 13 L17 17 Q17 19 15 19 L5 19 Q3 19 3 17 L3 7 Q3 5 5 5 L9 5"
            Stroke="{DynamicResource MainTextBrush}" StrokeThickness="1.7"
            StrokeLineCap="Round" Width="18" Height="18"
            Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate>
   </Setter>
  </Style>
  <Style Selector="Button.license-link:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/></Style>
  <Style Selector="Button.license-link:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource InfoBrush}"/></Style>
  <Style Selector="Button.license-link:focus"><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/></Style>
  <Style Selector="Border.theme-card"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Border.theme-card.selected"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style Selector="Border.theme-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style Selector="Border.language-card"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Border.language-card.selected"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
 </Window.Styles>
 <Grid RowDefinitions="54,*">
  <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <TextBlock Text="{DynamicResource Loc_SettingsTitle}" FontSize="20" FontWeight="SemiBold" Margin="22,0" VerticalAlignment="Center"/>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="226,*">
   <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,16">
    <StackPanel Spacing="10">
     <TextBlock Text="{DynamicResource Loc_SettingsSections}" Classes="secondary" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,2"/>
     <ListBox x:Name="SectionsList" SelectionChanged="Sections_SelectionChanged"
              Background="Transparent" BorderThickness="0" Padding="0"
              ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="↓" Width="20" TextAlignment="Center" FontSize="17"/><TextBlock Text="{DynamicResource Loc_SettingsInstaller}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◉" Width="20" TextAlignment="Center" FontSize="16"/><TextBlock Text="{DynamicResource Loc_SettingsAppearance}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="文" Width="20" TextAlignment="Center" FontSize="16"/><TextBlock Text="{DynamicResource Loc_LanguageSection}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="▦" Width="20" TextAlignment="Center" FontSize="17"/><TextBlock Text="{DynamicResource Loc_SettingsKnowledgeBase}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="ⓘ" Width="20" TextAlignment="Center" FontSize="17"/><TextBlock Text="{DynamicResource Loc_SettingsAbout}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
     </ListBox>
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="InstallerSection" Margin="24" Spacing="16">
      <TextBlock Text="{DynamicResource Loc_SettingsInstaller}" FontSize="21" FontWeight="SemiBold"/>
      <ContentControl x:Name="InstallerHost"/>
     </StackPanel>
     <StackPanel x:Name="AppearanceSection" Margin="24" Spacing="15" IsVisible="False">
      <TextBlock Text="{DynamicResource Loc_SettingsAppearance}" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource Loc_SettingsThemeLabel}" Classes="secondary"/>
      <StackPanel x:Name="ThemeOptions" Spacing="7">
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Studio Dark" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_SettingsThemeStudioDark}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_SettingsThemeStudioDarkDescription}" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#14171B"/><Border Width="7" Height="28" Background="#22262D"/><Border Width="7" Height="28" Background="#F5A623"/><Border Width="7" Height="28" Background="#F0F2F3"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Resolve-inspired Workspace" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_SettingsThemeResolve}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_SettingsThemeResolveDescription}" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#111419"/><Border Width="7" Height="28" Background="#1B1F26"/><Border Width="7" Height="28" Background="#DD3338"/><Border Width="7" Height="28" Background="#F0F1F3"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Adobe Clean Pro" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_SettingsThemeAdobe}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_SettingsThemeAdobeDescription}" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#171821"/><Border Width="7" Height="28" Background="#232431"/><Border Width="7" Height="28" Background="#A45ADB"/><Border Width="7" Height="28" Background="#F2F0F8"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Industrial Utility" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_SettingsThemeIndustrial}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_SettingsThemeIndustrialDescription}" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#111514"/><Border Width="7" Height="28" Background="#1B211F"/><Border Width="7" Height="28" Background="#39B85B"/><Border Width="7" Height="28" Background="#EFF7F0"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Hybrid Modern Panel" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_SettingsThemeHybrid}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_SettingsThemeHybridDescription}" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#101A23"/><Border Width="7" Height="28" Background="#1D2B36"/><Border Width="7" Height="28" Background="#27B9C1"/><Border Width="7" Height="28" Background="#E7F6F8"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
      </StackPanel>
      <StackPanel Spacing="6">
       <TextBlock Text="{DynamicResource Loc_SettingsInterfaceScale}" FontWeight="SemiBold"/>
       <ComboBox x:Name="InterfaceScaleBox" SelectionChanged="InterfaceScale_SelectionChanged" HorizontalAlignment="Left" MinWidth="145">
        <ComboBoxItem Tag="0" Content="{DynamicResource Loc_SettingsInterfaceScaleAuto}"/>
        <ComboBoxItem Tag="75" Content="75%"/><ComboBoxItem Tag="80" Content="80%"/>
        <ComboBoxItem Tag="85" Content="85%"/><ComboBoxItem Tag="90" Content="90%"/>
        <ComboBoxItem Tag="95" Content="95%"/><ComboBoxItem Tag="100" Content="100%"/>
        <ComboBoxItem Tag="105" Content="105%"/><ComboBoxItem Tag="110" Content="110%"/>
        <ComboBoxItem Tag="115" Content="115%"/><ComboBoxItem Tag="120" Content="120%"/>
        <ComboBoxItem Tag="125" Content="125%"/>
       </ComboBox>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="LanguageSection" Margin="24" Spacing="12" IsVisible="False">
      <TextBlock Text="{DynamicResource Loc_LanguageSection}" FontSize="21" FontWeight="SemiBold"/>
      <Grid x:Name="LanguageOptions" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
       <Border Tag="en" Grid.Row="0" Grid.Column="0" Classes="language-card selected" Height="60" BorderThickness="1" Padding="10,6">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageEnglishName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageEnglishDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="de" Grid.Row="0" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageGermanName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageGermanDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="fr" Grid.Row="1" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageFrenchName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageFrenchDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="es" Grid.Row="1" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageSpanishName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageSpanishDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="it" Grid.Row="2" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageItalianName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageItalianDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="pt" Grid.Row="2" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguagePortugueseName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguagePortugueseDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="ru" Grid.Row="3" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_RussianName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_RussianName}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton x:Name="RussianLanguageOption" Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="zh-CN" Grid.Row="3" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageChineseName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageChineseDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="ja" Grid.Row="4" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageJapaneseName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageJapaneseDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Tag="ko" Grid.Row="4" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource Loc_LanguageKoreanName}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_LanguageKoreanDescription}" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="FormatsSection" Margin="24" Spacing="16" IsVisible="False">
      <TextBlock Text="{DynamicResource Loc_SettingsGuideTitle}" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource Loc_SettingsGuideDescription1}" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource Loc_SettingsGuideDescription2}" TextWrapping="Wrap"/>
      <Button Content="{DynamicResource Loc_SettingsOpenGuide}" Click="OpenGuide_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     </StackPanel>
     <StackPanel x:Name="AboutSection" Margin="22,18" Spacing="14" IsVisible="False">
      <Grid ColumnDefinitions="64,*" ColumnSpacing="13">
       <Image Source="avares://MediaUnseal/Assets/Icons/MediaUnseal-128.png" Width="60" Height="60" Stretch="Uniform"/>
       <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Loc_SettingsProductName}" FontSize="23" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
         <TextBlock x:Name="VersionText" Classes="secondary" VerticalAlignment="Center" FontSize="12"/>
         <Button x:Name="UpdateButton" Click="UpdateButton_Click" Height="28" Padding="8,2"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12"/>
         <TextBlock x:Name="UpdateCurrentStatus" Text="{DynamicResource Loc_SettingsUpdateCurrent}"
                    Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" FontSize="12" IsVisible="False"/>
         <TextBlock x:Name="UpdateCheckingStatus" Text="{DynamicResource Loc_UpdateChecking}"
                    Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" IsVisible="False"/>
         <TextBlock x:Name="UpdateErrorStatus" Text="{DynamicResource Loc_UpdateCheckFailed}"
                    Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" FontSize="12" IsVisible="False"/>
         <TextBlock x:Name="UpdateAvailableStatus" Text="{DynamicResource Loc_SettingsUpdateAvailable}"
                    Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" FontSize="12" IsVisible="False"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button x:Name="CancelUpdateButton" Content="{DynamicResource Loc_UpdateCancelDownload}"
                 Click="CancelUpdate_Click" IsVisible="False" HorizontalContentAlignment="Center"/>
         <TextBlock x:Name="UpdateProgress" VerticalAlignment="Center" IsVisible="False"/>
        </StackPanel>
       </StackPanel>
      </Grid>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="5" Padding="12">
       <Grid ColumnDefinitions="143,1,*" ColumnSpacing="13">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center">
         <TextBlock Text="▶" FontSize="27" Foreground="{DynamicResource AccentBrush}"/>
         <TextBlock Text="♫" FontSize="25" Foreground="{DynamicResource InfoBrush}"/>
         <TextBlock Text="▧" FontSize="26" Foreground="{DynamicResource SuccessBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
        <TextBlock Grid.Column="2" Text="{DynamicResource Loc_SettingsAboutSummary}" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="5" Padding="13">
       <StackPanel Spacing="10">
        <TextBlock Text="{DynamicResource Loc_SettingsGeneralInformation}" FontWeight="SemiBold" FontSize="16"/>
        <Grid ColumnDefinitions="125,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7" ColumnSpacing="10">
         <TextBlock Text="{DynamicResource Loc_SettingsDeveloper}" Classes="secondary"/>
         <TextBlock Grid.Column="1" Text="{DynamicResource Loc_SettingsDeveloperName}"/>
         <TextBlock Grid.Row="1" Text="{DynamicResource Loc_SettingsPlatformsLabel}" Classes="secondary"/>
         <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Loc_SettingsPlatforms}" TextWrapping="Wrap"/>
         <TextBlock Grid.Row="2" Text="{DynamicResource Loc_SettingsTechnologyLabel}" Classes="secondary"/>
         <TextBlock x:Name="TechnologyText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
        </Grid>
       </StackPanel>
      </Border>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="5" Padding="13">
       <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource Loc_SettingsMediaComponents}" FontWeight="SemiBold" FontSize="16"/>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
        <Grid ColumnDefinitions="95,*" ColumnSpacing="10" ToolTip.Tip="{Binding FFmpegExecutablePath}">
         <TextBlock Text="FFmpeg" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="{Binding FFmpegBriefStatus}" TextWrapping="Wrap"/>
        </Grid>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
        <Grid ColumnDefinitions="95,*" ColumnSpacing="10" ToolTip.Tip="{Binding FFprobeExecutablePath}">
         <TextBlock Text="FFprobe" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="{Binding FFprobeBriefStatus}" TextWrapping="Wrap"/>
        </Grid>
        <TextBlock Text="{DynamicResource Loc_SettingsFfmpegRights}" Classes="secondary"
                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="5" Padding="13">
       <StackPanel Spacing="7">
        <TextBlock Text="{DynamicResource Loc_SettingsLicenses}" FontWeight="SemiBold" FontSize="16"/>
        <Grid ColumnDefinitions="150,*,30" ColumnSpacing="8">
         <TextBlock Text="{DynamicResource Loc_SettingsProductName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="Proprietary License (Source available)" VerticalAlignment="Center" Classes="secondary" TextWrapping="Wrap"/>
         <Button Grid.Column="2" Classes="license-link" Tag="https://github.com/SergeyBoytsovDev/MediaUnseal/blob/main/LICENSE.md"
                 Click="ExternalLink_Click" ToolTip.Tip="{DynamicResource Loc_SettingsOpenLicense}"/>
        </Grid>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
        <Grid ColumnDefinitions="150,*,30" ColumnSpacing="8">
         <TextBlock Text="FFmpeg / FFprobe" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <TextBlock x:Name="FfmpegLicenseText" Grid.Column="1" Text="{DynamicResource Loc_SettingsFfmpegLicense}" VerticalAlignment="Center"
                    Classes="secondary" TextWrapping="Wrap"/>
         <Button Grid.Column="2" Classes="license-link" Tag="https://ffmpeg.org/legal.html"
                 Click="ExternalLink_Click" ToolTip.Tip="{DynamicResource Loc_SettingsOpenLicense}"/>
        </Grid>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
        <Grid ColumnDefinitions="150,*,30" ColumnSpacing="8">
         <TextBlock Text="Avalonia UI" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="MIT License" VerticalAlignment="Center" Classes="secondary"/>
         <Button Grid.Column="2" Classes="license-link" Tag="https://github.com/AvaloniaUI/Avalonia/blob/main/licence.md"
                 Click="ExternalLink_Click" ToolTip.Tip="{DynamicResource Loc_SettingsOpenLicense}"/>
        </Grid>
       </StackPanel>
      </Border>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="5" Padding="13">
       <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource Loc_SettingsReportBug}" FontWeight="SemiBold" FontSize="16"/>
        <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto" RowSpacing="5">
         <TextBlock Text="{DynamicResource Loc_SettingsEmailLabel}" Classes="secondary"/>
         <Button Grid.Column="1" Classes="about-link" Tag="mailto:sergjoyce@gmail.com"
                 Click="ExternalLink_Click" HorizontalAlignment="Left"><TextBlock Text="sergjoyce@gmail.com"/></Button>
         <TextBlock Grid.Row="1" Text="{DynamicResource Loc_SettingsTelegramLabel}" Classes="secondary"/>
         <Button Grid.Row="1" Grid.Column="1" Classes="about-link"
                 Tag="https://t.me/SergeyBoytsov" Click="ExternalLink_Click"
                 HorizontalAlignment="Left"><TextBlock Text="@SergeyBoytsov"/></Button>
        </Grid>
       </StackPanel>
      </Border>
      <TextBlock x:Name="AboutActionError" Foreground="{DynamicResource ErrorBrush}"
                 IsVisible="False" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
       <TextBlock x:Name="AboutFooterText" Classes="secondary" FontSize="12"
                  VerticalAlignment="Center" TextWrapping="Wrap"/>
       <Button Grid.Column="1" Classes="about-link" Click="Support_Click" FontSize="12">
        <StackPanel Orientation="Horizontal" Spacing="5">
         <TextBlock Text="♥"/>
         <TextBlock Text="{DynamicResource Loc_SettingsSupportDeveloper}"/>
        </StackPanel>
       </Button>
      </Grid>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>


