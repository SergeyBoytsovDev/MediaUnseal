<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TrackExtractor.ViewModels"
        x:Class="TrackExtractor.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Настройки" Icon="/Assets/Icons/TrackExtractor-256.png"
        Width="870" Height="570" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Inter" FontSize="14">
 <Window.Styles>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Style>
  <Style Selector="RadioButton"><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/></Style>
  <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Border.theme-card"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Border.theme-card.selected"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style Selector="Border.theme-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style Selector="Border.language-card"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Border.language-card.selected"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
 </Window.Styles>
 <Grid RowDefinitions="54,*">
  <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" Margin="22,0" VerticalAlignment="Center"/>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="226,*">
   <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,16">
    <StackPanel Spacing="10">
     <TextBlock Text="РАЗДЕЛЫ" Classes="secondary" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,2"/>
     <ListBox x:Name="SectionsList" SelectionChanged="Sections_SelectionChanged"
              Background="Transparent" BorderThickness="0" Padding="0"
              ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="↓" Width="20" TextAlignment="Center" FontSize="17"/><TextBlock Text="Установщик FFmpeg" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◉" Width="20" TextAlignment="Center" FontSize="16"/><TextBlock Text="Оформление" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="文" Width="20" TextAlignment="Center" FontSize="16"/><TextBlock Text="Язык интерфейса" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="▦" Width="20" TextAlignment="Center" FontSize="17"/><TextBlock Text="База знаний" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
      <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="ⓘ" Width="20" TextAlignment="Center" FontSize="17"/><TextBlock Text="О программе" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
     </ListBox>
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="InstallerSection" Margin="24" Spacing="16">
      <TextBlock Text="Установщик FFmpeg" FontSize="21" FontWeight="SemiBold"/>
      <ContentControl x:Name="InstallerHost"/>
     </StackPanel>
     <StackPanel x:Name="AppearanceSection" Margin="24" Spacing="15" IsVisible="False">
      <TextBlock Text="Оформление" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Тема интерфейса" Classes="secondary"/>
      <StackPanel x:Name="ThemeOptions" Spacing="7">
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Studio Dark" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="Studio Dark" FontWeight="SemiBold"/><TextBlock Text="Контрастный студийный стиль" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#14171B"/><Border Width="7" Height="28" Background="#22262D"/><Border Width="7" Height="28" Background="#F5A623"/><Border Width="7" Height="28" Background="#F0F2F3"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Resolve-inspired Workspace" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="Resolve Workspace" FontWeight="SemiBold"/><TextBlock Text="Плотная рабочая среда" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#111419"/><Border Width="7" Height="28" Background="#1B1F26"/><Border Width="7" Height="28" Background="#DD3338"/><Border Width="7" Height="28" Background="#F0F1F3"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Adobe Clean Pro" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="Adobe Clean Pro" FontWeight="SemiBold"/><TextBlock Text="Чистая типографика и отступы" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#171821"/><Border Width="7" Height="28" Background="#232431"/><Border Width="7" Height="28" Background="#A45ADB"/><Border Width="7" Height="28" Background="#F2F0F8"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Industrial Utility" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="Industrial Utility" FontWeight="SemiBold"/><TextBlock Text="Строгая утилитарная тема" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#111514"/><Border Width="7" Height="28" Background="#1B211F"/><Border Width="7" Height="28" Background="#39B85B"/><Border Width="7" Height="28" Background="#EFF7F0"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
       <Border Classes="theme-card" Height="62" BorderThickness="1" Padding="10,5">
        <RadioButton Tag="Hybrid Modern Panel" GroupName="Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2"><TextBlock Text="Hybrid Modern Panel" FontWeight="SemiBold"/><TextBlock Text="Мягкие панели и холодный акцент" FontSize="12" Classes="secondary"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
           <Border Width="7" Height="28" Background="#101A23"/><Border Width="7" Height="28" Background="#1D2B36"/><Border Width="7" Height="28" Background="#27B9C1"/><Border Width="7" Height="28" Background="#E7F6F8"/>
          </StackPanel>
         </Grid>
        </RadioButton>
       </Border>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="LanguageSection" Margin="24" Spacing="12" IsVisible="False">
      <TextBlock Text="Язык интерфейса" FontSize="21" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
       <Border Grid.Row="0" Grid.Column="0" Classes="language-card selected" Height="60" BorderThickness="1" Padding="10,6">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Русский" FontWeight="SemiBold"/><TextBlock Text="Русский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsChecked="True" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="0" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="English" FontWeight="SemiBold"/><TextBlock Text="Английский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="1" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Deutsch" FontWeight="SemiBold"/><TextBlock Text="Немецкий" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="1" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Français" FontWeight="SemiBold"/><TextBlock Text="Французский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="2" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Español" FontWeight="SemiBold"/><TextBlock Text="Испанский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="2" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Português" FontWeight="SemiBold"/><TextBlock Text="Португальский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="3" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Italiano" FontWeight="SemiBold"/><TextBlock Text="Итальянский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="3" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="中文（简体）" FontWeight="SemiBold"/><TextBlock Text="Китайский (упрощённый)" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="4" Grid.Column="0" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="日本語" FontWeight="SemiBold"/><TextBlock Text="Японский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
       <Border Grid.Row="4" Grid.Column="1" Classes="language-card" Height="60" BorderThickness="1" Padding="10,6" Opacity="0.55">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="한국어" FontWeight="SemiBold"/><TextBlock Text="Корейский" Classes="secondary" FontSize="12"/></StackPanel><RadioButton Grid.Column="1" IsEnabled="False" VerticalAlignment="Center"/></Grid>
       </Border>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="FormatsSection" Margin="24" Spacing="16" IsVisible="False">
      <TextBlock Text="Медиасправочник" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Справочник форматов содержит информацию о мультимедийных контейнерах, видео- и аудиокодеках, форматах субтитров и изображений." TextWrapping="Wrap"/>
      <TextBlock Text="Здесь вы сможете узнать об особенностях различных форматов, их совместимости, назначении и использовании при извлечении и конвертации медиапотоков." TextWrapping="Wrap"/>
      <Button Content="Открыть справочник" IsEnabled="False" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     </StackPanel>
     <StackPanel x:Name="AboutSection" Margin="24,16" Spacing="5" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="14">
       <Image Source="avares://TrackExtractor/Assets/Icons/TrackExtractor-128.png" Width="54" Height="54" Stretch="Uniform"/>
       <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Track Extractor" FontSize="21" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="9">
         <TextBlock x:Name="VersionText" Classes="secondary" VerticalAlignment="Center"/>
         <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="5,1"><TextBlock Text="Development" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></Border>
        </StackPanel>
       </StackPanel>
      </StackPanel>
      <TextBlock Text="Анализ мультимедийных файлов и извлечение видео, аудио, субтитров и вложений." TextWrapping="Wrap"/>
      <Button IsEnabled="False" HorizontalAlignment="Left" Padding="9,5">
       <StackPanel Orientation="Horizontal" Spacing="7">
        <Path Data="M 20,7 L 20,2 L 15,2 M 20,2 C 17,0 13,0 10,1 C 5,3 3,7 3,11 M 4,17 L 4,22 L 9,22 M 4,22 C 7,24 11,24 14,23 C 19,21 21,17 21,13" Stroke="{DynamicResource MainTextBrush}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
        <TextBlock Text="Проверить обновления" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,3"/>
      <TextBlock Text="Общие сведения" FontWeight="SemiBold"/>
      <TextBlock Text="Разработчик: Sergey Boitcov"/>
      <TextBlock Text="Платформы: Windows 10/11, Linux; macOS — планируется" TextWrapping="Wrap"/>
      <TextBlock Text="Технологии: .NET 10, Avalonia UI 12.1.4"/>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,3"/>
      <TextBlock Text="Мультимедийные компоненты" FontWeight="SemiBold"/>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="9,5">
       <Grid ColumnDefinitions="80,*"><TextBlock Text="FFmpeg" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding FFmpegBriefStatus}" TextWrapping="Wrap"/></Grid>
      </Border>
      <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="9,5">
       <Grid ColumnDefinitions="80,*"><TextBlock Text="FFprobe" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding FFprobeBriefStatus}" TextWrapping="Wrap"/></Grid>
      </Border>
      <TextBlock Text="{Binding KnownBuildSource}" IsVisible="{Binding HasKnownBuildSource}" Classes="secondary" FontSize="12"/>
      <TextBlock Text="Права на FFmpeg и FFprobe принадлежат их правообладателям; поставщик готовой сборки может отличаться." Classes="secondary" FontSize="12" TextWrapping="Wrap"/>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,3"/>
      <TextBlock Text="Сторонние компоненты и лицензии" FontWeight="SemiBold"/>
      <TextBlock Text="Avalonia UI — интерфейс приложения."/>
      <TextBlock Text="CommunityToolkit.Mvvm — поддержка MVVM."/>
      <TextBlock Text="FFmpeg и FFprobe — внешние утилиты обработки и анализа медиафайлов." TextWrapping="Wrap"/>
      <TextBlock Text="Лицензионная информация будет дополнена перед выпуском" Classes="secondary" FontSize="12" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
