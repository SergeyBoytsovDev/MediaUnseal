<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:MediaUnseal.Services"
        x:Class="MediaUnseal.Views.ConversionWindow"
        Title="{DynamicResource Loc_ConversionWindowTitle}" Icon="/Assets/Icons/MediaUnseal-256.png"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource MainTextBrush}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="14">
 <Window.Styles>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Style>
  <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource PanelAltBackground}"/><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style Selector="ComboBox.numeric"><Setter Property="IsEditable" Value="True"/><Setter Property="PlaceholderText" Value="{DynamicResource Loc_ConversionAutomatic}"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
 </Window.Styles>
 <Grid RowDefinitions="Auto,Auto">
   <StackPanel Margin="18,16" Spacing="8">
    <TextBlock x:Name="StreamHeading" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock x:Name="VisualOutputHint" Classes="muted" TextWrapping="Wrap" IsVisible="False"/>
    <TextBlock Text="{DynamicResource Loc_ConversionSeparateFilesHint}" Classes="muted" TextWrapping="Wrap"/>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,2"/>
    <TextBlock Text="{DynamicResource Loc_ConversionOutputFormat}" FontWeight="SemiBold"/>
    <ComboBox x:Name="FormatBox" SelectionChanged="Format_SelectionChanged" HorizontalAlignment="Stretch">
     <ComboBox.ItemTemplate><DataTemplate x:DataType="services:ConversionFormat">
      <StackPanel>
       <Border Height="1" Margin="0,4,0,5" Background="{DynamicResource LineBrush}"
               IsVisible="False" Loaded="FormatDivider_Loaded"/>
       <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{DynamicResource Loc_ConversionEncoder}" FontWeight="SemiBold" Margin="0,3,0,0"/>
    <ComboBox x:Name="EncoderBox" SelectionChanged="Encoder_SelectionChanged" HorizontalAlignment="Stretch">
     <ComboBox.ItemTemplate>
      <DataTemplate x:DataType="services:ConversionEncoder">
       <StackPanel>
        <Border Height="1" Margin="0,4,0,5" Background="{DynamicResource LineBrush}"
                IsVisible="False" Loaded="HardwareDivider_Loaded"/>
        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" Loaded="EncoderLabel_Loaded"/>
       </StackPanel>
      </DataTemplate>
     </ComboBox.ItemTemplate>
    </ComboBox>
    <CheckBox x:Name="ForceReencodeBox" Content="{DynamicResource Loc_ConversionForceReencode}"
              IsVisible="False"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
     <Button x:Name="MoreEncodersButton" Content="{DynamicResource Loc_ConversionFindCompatible}" Click="MoreEncoders_Click"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="8,6" MinHeight="36"/>
     <Button x:Name="HardwareButton" Grid.Column="1" Content="{DynamicResource Loc_ConversionFindHardware}" Click="Hardware_Click"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="8,6" MinHeight="36"/>
    </Grid>
    <Border Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" Padding="10,7" MinHeight="38">
     <TextBlock x:Name="EncoderNote" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </Border>
    <Border x:Name="VideoOptions" Background="{DynamicResource PanelAltBackground}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,5,0,0">
     <StackPanel Spacing="9">
      <TextBlock Text="{DynamicResource Loc_ConversionVideoOptions}" FontWeight="SemiBold" FontSize="15"/>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
       <StackPanel Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionCrf}"/><ComboBox x:Name="CrfBox" Classes="numeric"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionBitrate}"/><ComboBox x:Name="VideoBitrateBox" Classes="numeric"/></StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
       <StackPanel Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionWidth}"/><ComboBox x:Name="WidthBox" Classes="numeric"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionHeight}"/><ComboBox x:Name="HeightBox" Classes="numeric"/></StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
       <StackPanel Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionFrameRate}"/><ComboBox x:Name="FrameRateBox" Classes="numeric"/></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Border x:Name="AudioOptions" Background="{DynamicResource PanelAltBackground}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,5,0,0">
     <StackPanel Spacing="9">
      <TextBlock Text="{DynamicResource Loc_ConversionAudioOptions}" FontWeight="SemiBold" FontSize="15"/>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
       <StackPanel Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionBitrate}"/><ComboBox x:Name="AudioBitrateBox" Classes="numeric"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionQuality}"/><ComboBox x:Name="QualityBox" Classes="numeric"/></StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
       <StackPanel Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionSampleRate}"/><ComboBox x:Name="SampleRateBox" Classes="numeric"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource Loc_ConversionChannels}"/><ComboBox x:Name="ChannelsBox" Classes="numeric"/></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
   </StackPanel>
  <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,10">
    <Button Content="{DynamicResource Loc_ConversionCancel}" Click="Cancel_Click" Padding="18,7" Height="38" HorizontalContentAlignment="Center"/>
    <Button x:Name="SaveButton" Classes="primary" Content="{DynamicResource Loc_ConversionApply}" Click="Save_Click" Padding="18,7" Height="38" HorizontalContentAlignment="Center"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
