<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TrackExtractor.ViewModels"
        x:Class="TrackExtractor.Views.DependencyDialog"
        x:DataType="vm:MainViewModel"
        Title="Проверка FFmpeg и FFprobe"
        Width="620" MinHeight="310" MaxHeight="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Для работы с медиафайлами нужны FFmpeg и FFprobe."
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding FFmpegStatus}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FFprobeStatus}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding InstallOption}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                     IsIndeterminate="{Binding ProgressIndeterminate}" IsVisible="{Binding IsBusy}" />
        <Button Content="Отменить" Click="Cancel_Click" IsVisible="{Binding IsBusy}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsTools}">
            <Button Content="Установить" Click="Install_Click" IsEnabled="{Binding CanAct}" />
            <Button Content="Указать путь FFmpeg" Click="SelectFFmpeg_Click" IsEnabled="{Binding CanAct}" />
            <Button Content="Указать путь FFprobe" Click="SelectFFprobe_Click" IsEnabled="{Binding CanAct}" />
        </StackPanel>
        <Button Content="Повторить проверку" Click="Retry_Click"
                HorizontalAlignment="Left" IsEnabled="{Binding CanAct}" IsVisible="{Binding NeedsTools}" />
        <Button Content="Продолжить" Click="Continue_Click"
                HorizontalAlignment="Left" IsEnabled="{Binding CanAct}" IsVisible="{Binding IsReady}" />
    </StackPanel>
    </ScrollViewer>
</Window>
