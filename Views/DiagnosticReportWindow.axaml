<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrackExtractor.Views.DiagnosticReportWindow"
        x:CompileBindings="False"
        Title="{DynamicResource Loc_DiagnosticPreviewTitle}"
        Width="760" Height="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Consolas,DejaVu Sans Mono" FontSize="12">
 <Window.Styles>
  <Style Selector="ListBoxItem">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="MinHeight" Value="0"/>
  </Style>
 </Window.Styles>
 <Grid RowDefinitions="*,Auto" Margin="12" RowSpacing="10">
  <ListBox x:Name="Entries" Grid.Row="0" Background="{DynamicResource PanelAltBackground}"
           BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemsPanel>
    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
   </ListBox.ItemsPanel>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Grid Margin="10,2">
      <Grid IsVisible="{Binding IsDate}" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,8,0,6">
       <Border Grid.Column="0" Background="{DynamicResource LineBrush}" Height="1" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}"/>
       <Border Grid.Column="2" Background="{DynamicResource LineBrush}" Height="1" VerticalAlignment="Center"/>
      </Grid>
      <Grid IsVisible="{Binding IsStartup}" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,8,0,5">
       <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}"/>
       <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Height="1" VerticalAlignment="Center"/>
      </Grid>
      <Grid IsVisible="{Binding IsEntry}" ColumnDefinitions="70,52,150,*" ColumnSpacing="8">
       <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{DynamicResource MutedTextBrush}"/>
       <Grid Grid.Column="1">
        <TextBlock Text="INFO" IsVisible="{Binding IsInfo}" Foreground="{DynamicResource SuccessBrush}"/>
        <TextBlock Text="WARN" IsVisible="{Binding IsWarn}" Foreground="{DynamicResource WarningBrush}"/>
        <TextBlock Text="ERROR" IsVisible="{Binding IsError}" Foreground="{DynamicResource ErrorBrush}"/>
       </Grid>
       <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
       <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource MainTextBrush}" TextWrapping="Wrap"/>
      </Grid>
     </Grid>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
   <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
    <TextBlock x:Name="EventsCount" Foreground="{DynamicResource SuccessBrush}"/>
    <TextBlock x:Name="WarningsCount" Foreground="{DynamicResource WarningBrush}"/>
    <TextBlock x:Name="ErrorsCount" Foreground="{DynamicResource ErrorBrush}"/>
   </StackPanel>
   <Grid Grid.Column="1" ColumnSpacing="8" Grid.IsSharedSizeScope="True">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticActions"/>
     <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticActions"/>
    </Grid.ColumnDefinitions>
    <Button x:Name="ClearButton" MinWidth="80" Content="{DynamicResource Loc_DiagnosticPreviewClear}" Click="Clear_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    <Button x:Name="SaveButton" Grid.Column="1" MinWidth="80" Content="{DynamicResource Loc_DiagnosticPreviewSave}" Click="Save_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
